# Copia este archivo como .env.local y llena los valores desde
# Supabase > Project Settings > API.

# Segura de exponer en el navegador (protegida por RLS).
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# NUNCA la expongas en el navegador ni le pongas prefijo NEXT_PUBLIC_.
# Solo la usan las rutas app/api/* (utils/supabase-server.js).
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
